@page "/productos"
@rendermode InteractiveServer
@using ProductosCURD.Models
@using ProductosCURD.Services 
@inject GestorProductos Gestor

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

@if (!string.IsNullOrEmpty(mensajeOk))
{
    <div class="alert alert-success">@mensajeOk</div>
}

<h3>Productos</h3>

<div class="card mb-4">
    <div class="card-body">
        <h5>@(editando ? "Editar Producto" : "Agregar Nuevo Producto")</h5>
        <div class="row">
            <div class="col">
                <label class="form-label">Nombre:</label>
                <input type="text" class="form-control" placeholder="Nombre del producto"
                       @bind-value="nuevoProducto.Nombre" />
            </div>
            <div class="col">
                <label class="form-label">Precio:</label>
                <input type="number" class="form-control" placeholder="Precio"
                       @bind-value="nuevoProducto.Precio" />
            </div>
            <div class="col">
                <label class="form-label">Stock:</label>
                <input type="number" class="form-control" placeholder="Stock"
                       @bind-value="nuevoProducto.Stock" />
            </div>  
        </div>
        <div class="mt-2">
            @if (editando)
            {
                <button class="btn btn-primary me-2" @onclick="GuardarProducto">Actualizar</button>
                <button class="btn btn-secondary" @onclick="CancelarEdicion">Cancelar</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="GuardarProducto">Agregar +</button>
            }
        </div>
    </div>
</div>
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Buscar por nombre</label>
                <input class="form-control"
                       placeholder="Ej. Laptop"
                       @bind="filtroNombre"
                       @oninput="AplicarFiltros" />
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox"
                           @bind="soloDisponibles"
                           @bind:after="AplicarFiltros" />
                    <label class="form-check-label">
                        Solo disponibles
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox"
                           @bind="soloSinStock"
                           @bind:after="AplicarFiltros" />
                    <label class="form-check-label">
                        Sin stock
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

@if (productos is null)
{
    <p>Cargando...</p>
}
else if(productos.Count == 0)
{
    <p>No hay productos aun agregados</p>
}
else
{
    <table class="table table-striped-columns">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Precio</th>
                <th scope="col">Stock</th>
                <th scope="col">Disponible</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var producto in productosFiltrados)
            {
            <tr>
                <td scope="row">@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.Precio</td>
                <td>@producto.Stock</td>
                <td>@(producto.Disponible ? "Disponible" : "No disponible")</td>
                <td class="text-center align-middle" style="width: 110px;">
                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => EliminarProducto(producto.Id)"><i class="bi bi-trash"></i></button>
                    <button type="button" class="btn btn-warning btn-sm" @onclick="() => EditarProducto(producto.Id)"><i class="bi bi-pencil-square"></i></button></td>
            </tr>
            }
        </tbody>
    </table>
}
@code {
    private string? mensajeError;
    private string? mensajeOk;
    private List<Producto> productosFiltrados = new();

    private bool editando = false;

    private List<Producto> productos = new();
    Producto nuevoProducto = new();

    private string filtroNombre = string.Empty;
    private bool soloDisponibles = false;
    private bool soloSinStock = false;

    protected override void OnInitialized()
    {
        productos = Gestor.ObtenerProductos();
    }
    private void CargarProductos()
    {
        productos = Gestor.ObtenerProductos();
        AplicarFiltros();
    }
    private void GuardarProducto()
    {
        if (!ValidarProducto())
            return;

        if (string.IsNullOrWhiteSpace(nuevoProducto.Nombre)) return;
        nuevoProducto.Disponible = nuevoProducto.Stock > 0;

        if (editando)
        {
            var actualizado = Gestor.EditarProducto(nuevoProducto);
            if (actualizado)
            {
                mensajeOk = "Producto actualizado correctamente";
                editando = false;
                nuevoProducto = new Producto();
                CargarProductos();
            }
            else
            {
            }
        }
        else
        {
            mensajeOk = "Producto agregado correctamente";
            Gestor.AgregarProducto(nuevoProducto);
            nuevoProducto = new Producto();
            CargarProductos();
            
        }
    }
    private void EliminarProducto(int id)
    {
        var eliminado = Gestor.EliminarProducto(id);
        if (eliminado)
        {
            CargarProductos();
        }
        else
        {

        }
    }
    private void EditarProducto(int id)
    {
        var producto = productos.FirstOrDefault(p => p.Id == id);
        if (producto is null) return;

        nuevoProducto = new Producto
            {
                Id = producto.Id,
                Nombre = producto.Nombre,
                Precio = producto.Precio,
                Stock = producto.Stock
            };
        editando = true;
    }
    private void CancelarEdicion()
    {
        editando = false;
        nuevoProducto = new Producto();
    }
    private bool ValidarProducto()
    {
        mensajeError = null;
        mensajeOk = null;

        if (string.IsNullOrWhiteSpace(nuevoProducto.Nombre))
        {
            mensajeError = "El nombre del producto es obligatorio";
            return false;
        }

        if (nuevoProducto.Precio <= 0)
        {
            mensajeError = "El precio debe ser mayor a 0";
            return false;
        }

        if (nuevoProducto.Stock < 0)
        {
            mensajeError = "El stock no puede ser negativo";
            return false;
        }

        return true;
    }
    private void AplicarFiltros()
    {
        productosFiltrados = productos
            .Where(p =>
                (string.IsNullOrWhiteSpace(filtroNombre)
                 || p.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
                &&
                (!soloDisponibles || p.Disponible)
                &&
                (!soloSinStock || p.Stock == 0)
            )
            .ToList();
    }


}
